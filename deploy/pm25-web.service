[Unit]
Description=PM2.5 dashboard web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pm25-web
Group=pm25-data
UMask=0007
WorkingDirectory={{REPO}}
# Dashboard OTA token (root-only file; systemd reads it before dropping privileges).
EnvironmentFile=-/etc/pm25/update.env
ExecStart={{PYTHON}} -m pm25.web --config /etc/pm25/config.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pm25
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
