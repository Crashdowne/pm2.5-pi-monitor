# Cloudflare Tunnel token for the PM2.5 dashboard.
# Copy to /etc/pm25/cloudflared.env (root:root, chmod 600) and paste your tunnel token.
# Create the tunnel in the Cloudflare Zero Trust dashboard and set its public hostname to
# http://localhost:8080. Only needed if you enable pm25-cloudflared.service.
CF_TUNNEL_TOKEN=
