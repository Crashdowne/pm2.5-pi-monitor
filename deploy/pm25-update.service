[Unit]
Description=PM2.5 monitor: apply an update requested from the dashboard
Documentation=file://{{REPO}}/docs/OTA.md
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
ExecStart={{REPO}}/deploy/update.sh --request
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
