# Local development secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored).
# In production set these with: wrangler secret put INGEST_TOKEN

# Bearer token the Pi must present to POST /ingest. Generate a strong random value,
# e.g. `openssl rand -hex 32`, and set the same value in the Pi's PM25_SYNC_TOKEN env.
INGEST_TOKEN = "change-me-local-ingest-token"

# Optional: bearer token for a protected ntfy topic.
# NTFY_TOKEN = ""
